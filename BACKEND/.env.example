PORT=

# Origens autorizadas a chamar a API (separadas por virgula), ex:
# http://localhost:5173,https://denarius-tau.vercel.app
# Sem esta variavel, cai no localhost de desenvolvimento.
CORS_ORIGINS=

DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=

# TLS da conexao com o Postgres ('true'/'false'). Vazio = usa o comportamento
# antigo (SSL desligado so quando DB_HOST='localhost').
DB_SSL=

JWT_SECRET=

# Proxies a frente da aplicacao (rate limiting usa isso para achar o IP real).
# Local, sem proxy: 0. No Render: 1.
TRUST_PROXY_HOPS=
